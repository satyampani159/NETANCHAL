# Copy these into your host's environment settings (Render, Railway...). All are optional.
PORT=3000
# Websites allowed to connect. Comma-separated; wildcards allowed. Unset = anyone (testing only).
ALLOWED_ORIGINS=https://your-site.vercel.app,https://*.vercel.app
# Set to 1 when the host puts a proxy in front (Render, Railway)
TRUST_PROXY=1
TICK_RATE=30
SNAPSHOT_RATE=30
MAX_ROOMS=50
MAX_CONN_PER_IP=12
